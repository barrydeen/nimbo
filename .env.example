# Copy this file to `docker/.env` for Docker Compose. Never commit the real
# `.env` (it is git-ignored). All values below are optional unless marked
# required for the production example.
#
# Generate secrets with: openssl rand -hex 32

# ---------------------------------------------------------------------------
# Local / single-host Compose (docker-compose.yml)
# ---------------------------------------------------------------------------

# Host interface and port for the published HTTP port. The default keeps the
# instance reachable only from this machine. Set 0.0.0.0 only behind a firewall
# and a TLS proxy; see docs/operations.md.
NIMBO_PUBLISH_HOST=127.0.0.1
NIMBO_PUBLISH_PORT=8080

# One-time bootstrap credential for POST /api/setup. When set, first-run setup
# requires this value. Set it before exposing the instance beyond loopback.
# Leave commented out only for a strictly local, single-user first run.
# NIMBO_SETUP_TOKEN=

# Mark the session cookie Secure. Set true once the browser URL is HTTPS.
# With the default HTTP quick start this must remain false or login breaks.
NIMBO_SECURE_COOKIES=false

# Session lifetime in days (positive integer).
NIMBO_SESSION_TTL_DAYS=30

# Audit-row retention in days. Expired sessions are purged automatically.
NIMBO_AUDIT_RETENTION_DAYS=90

# Direct-run listen address. Compose overrides this to 0.0.0.0:8080 inside the
# container so the published port can reach it.
# NIMBO_BIND=127.0.0.1:8080

# Per-file upload ceiling in MiB. The whole multipart request is allowed
# roughly this value + 1 MiB, so a batch of individually valid files can still
# exceed the request cap. Split large uploads into smaller batches.
NIMBO_MAX_UPLOAD_MB=200

# Container resource backstops. They do not replace per-parser limits.
NIMBO_CPUS=2.0
NIMBO_MEMORY=2g

# Log level/filter passed to RUST_LOG and rotated by Compose (10 MiB x 3).
NIMBO_LOG=nimbo=info,tower_http=info

# Optional image name. The development quick start builds from source and
# tags it nimbo:local. Production deployments should pin a released version.
# NIMBO_IMAGE=ghcr.io/barrydeen/nimbo:0.2.0

# ---------------------------------------------------------------------------
# Production TLS example (docker-compose.production.yml)
# ---------------------------------------------------------------------------

# Required by docker-compose.production.yml: public DNS name for the proxy.
NIMBO_DOMAIN=

# Directory containing fullchain.pem and privkey.pem. Never commit it.
# The proxy runs as UID/GID 101: own the files by 101 and use owner-only mode
# (chown 101:101, chmod 600), or adjust for your custom proxy UID / secret.
NIMBO_TLS_DIR=./tls

# Edge bind address and ports.
NIMBO_EDGE_BIND=0.0.0.0
NIMBO_HTTP_PORT=80
NIMBO_HTTPS_PORT=443

# Proxy request-body ceiling. Keep at NIMBO_MAX_UPLOAD_MB + 1 MiB or larger.
NIMBO_PROXY_BODY_LIMIT=201m

# Optional proxy image override; the production default is digest-pinned.
# NIMBO_PROXY_IMAGE=nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236
NIMBO_PROXY_CPUS=1.0
NIMBO_PROXY_MEMORY=256m
