# Copy this file to `.env` for docker compose. Never commit the real `.env`.
# All values are optional; the defaults shown are what Nimbo uses when unset.

# Listen address (inside the container).
NIMBO_BIND=0.0.0.0:8080

# Set to "true" when serving behind HTTPS so the session cookie is Secure.
NIMBO_SECURE_COOKIES=false

# Session lifetime in days.
NIMBO_SESSION_TTL_DAYS=30

# Maximum size of a single uploaded file, in MiB.
NIMBO_MAX_UPLOAD_MB=200
